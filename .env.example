# ============================================================
# CONFIGURACIÓN DE ENTORNO - Vue Admin Frontend
# ============================================================
# Este archivo es una plantilla para las variables de entorno.
# Copia este archivo a .env y ajusta los valores según tu entorno.
#
# REGLAS IMPORTANTES:
# - NO uses este archivo directamente, cópialo a .env
# - Las variables con VITE_ son accesibles desde el navegador
# - Las variables sin VITE_ son solo para tiempo de build
# - Los comentarios que comienzan con # son ignorados
# ============================================================

# ============================================================
# CONFIGURACIÓN DE VITE
# ============================================================

# URL base para la aplicación
# - '/' para desarrollo local
# - '/admin-one-vue-tailwind/' para producción en subdirectorio
VITE_BASE_URL=/

# ============================================================
# CONFIGURACIÓN DEL BACKEND (API)
# ============================================================

# URL base del backend FastAPI
# Ejemplos:
#   Desarrollo: http://0.0.0.1:8000
#   Producción: https://api.tudominio.com
VITE_API_BASE_URL=http://0.0.0.0:8000

# Timeout para peticiones HTTP (milisegundos)
VITE_API_TIMEOUT=10000

# ============================================================
# CONFIGURACIÓN DE AUTENTICACIÓN (JWT)
# ============================================================

# Tiempo de expiración del token (minutos)
VITE_TOKEN_EXPIRATION_MINUTES=60

# Días para recordar sesión
VITE_REMEMBER_ME_DAYS=7

# Claves de almacenamiento en localStorage
VITE_TOKEN_STORAGE_KEY=token
VITE_USER_STORAGE_KEY=user
VITE_PASSWORD_CHANGE_STORAGE_KEY=mustChangePassword

# ============================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================================

# Nombre de la aplicación
VITE_APP_NAME=Fontibón Reservado

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# Modo debug (true/false)
VITE_APP_DEBUG=true

# ============================================================
# CONFIGURACIÓN DE NOTIFICACIONES
# ============================================================

# Duración de notificaciones Toast (ms)
VITE_TOAST_DURATION=3000

# Posición de notificaciones
VITE_TOAST_POSITION=top-right

# ============================================================
# CONFIGURACIÓN DE PAGINACIÓN
# ============================================================

# Items por página por defecto
VITE_DEFAULT_ITEMS_PER_PAGE=10

# Opciones de paginación disponibles
VITE_ITEMS_PER_PAGE_OPTIONS=5,10,25,50,100

# ============================================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================================

# Tamaño máximo de archivos (MB)
VITE_MAX_FILE_SIZE_MB=10

# Tipos de archivos permitidos
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/svg+xml
VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================
# CONFIGURACIÓN DE SEGURIDAD
# ============================================================

# URLs protegidas (no redirigir después de login)
VITE_PROTECTED_REDIRECT_URLS=/login,/registro,/forgot-password

# Longitud mínima de contraseña
VITE_MIN_PASSWORD_LENGTH=8

# Patrón de contraseña (regex)
VITE_PASSWORD_PATTERN=^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$

# ============================================================
# CONFIGURACIÓN DE RATE LIMITING
# ============================================================

# Máximo de intentos de login fallidos
VITE_MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo (minutos)
VITE_LOGIN_LOCKOUT_MINUTES=15

# ============================================================
# FEATURE FLAGS (Habilitar/Deshabilitar funcionalidades)
# ============================================================

# Registro de usuarios
VITE_ENABLE_REGISTRATION=true

# Cambio de contraseña
VITE_ENABLE_PASSWORD_CHANGE=true

# Modo oscuro
VITE_ENABLE_DARK_MODE=true

# Notificaciones
VITE_ENABLE_NOTIFICATIONS=true

# Logs de debug
VITE_ENABLE_DEBUG_LOGS=true

# Exportación de datos
VITE_ENABLE_DATA_EXPORT=true

# ============================================================
# ANALYTICS (Dejar vacío si no se usa)
# ============================================================

VITE_GA_TRACKING_ID=
VITE_MATOMO_URL=

# ============================================================
# SENTRY - Monitoreo de errores
# ============================================================

VITE_SENTRY_DSN=

# ============================================================
# SERVICIOS EXTERNOS (Opcional)
# ============================================================

# VITE_EXTERNAL_API_KEY=
# VITE_MAPS_SERVICE_URL=
# VITE_WS_URL=ws://127.0.0.1:8000

# ============================================================
# ⚠️ IMPORTANTE: Variables sensibles
# ============================================================
# API Keys secretas y credenciales NO deben estar en este archivo
# Configúralas en el servidor de producción o usa un gestor de secrets
# ============================================================